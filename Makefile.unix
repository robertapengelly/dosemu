#******************************************************************************
# @file             Makefile.unix
#******************************************************************************
SRCDIR              ?=  $(CURDIR)
VPATH               :=  $(SRCDIR)

CC                  :=  gcc
CFLAGS              :=  -D_FILE_OFFSET_BITS=64 -O2 -Wall -Werror -Wextra

CC_SRC              :=  $(wildcard $(SRCDIR)/*.c)

ifeq ($(OS), Windows_NT)
LIBS                :=  -lm -lwinmm
else ifeq ($(shell uname -s), Darwin)
CFLAGS              +=  -pthread
LIBS                :=  -lm -framework AudioToolbox
else ifeq ($(shell uname -s), Linux)
CFLAGS              +=  -pthread
LIBS                :=  -lm -ldl
else
LIBS                :=  -lm
endif

ifeq ($(OS), Windows_NT)
all: dosemu.exe

dosemu.exe: $(CC_SRC)

	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)
else
all: dosemu

dosemu: $(CC_SRC)

	$(CC) $(CFLAGS) -o $@ $^ $(LIBS)
endif

clean:

	if [ -f dosemu.exe ]; then rm -rf dosemu.exe; fi
	if [ -f dosemu ]; then rm -rf dosemu; fi
